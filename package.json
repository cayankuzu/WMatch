{
  "name": "wmatch-mobile",
  "private": true,
  "version": "1.0.50",
  "main": "index.ts",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-dev-client.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-dev-client.ps1",
    "dev:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-dev-client.ps1",
    "dev:lan": "expo start --dev-client --clear --host lan",
    "dev:expo": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-dev-client.ps1",
    "dev:localhost": "expo start --dev-client --clear --host localhost",
    "android": "expo run:android",
    "logs:android": "powershell -ExecutionPolicy Bypass -File .\\watch-android-logs.ps1",
    "android:expo-go": "expo start --android",
    "ios": "expo run:ios",
    "ios:expo-go": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/check-source-quality.mjs",
    "test": "npm run test:vitest && npm run test:component",
    "test:vitest": "vitest run",
    "test:unit": "vitest run tests/shared-utils.test.ts tests/network-retry.test.ts tests/edge-http-security.test.ts",
    "test:component": "jest --config jest.config.js --runInBand",
    "test:contract": "vitest run tests/production-guards.test.ts",
    "test:rls": "supabase test db supabase/tests/database",
    "test:rls:static": "node scripts/check-migrations.mjs",
    "check:signing": "node scripts/check-signing-identity.mjs",
    "check:secrets": "node scripts/check-no-private-secrets.mjs",
    "check:licenses": "node scripts/check-dependency-licenses.mjs",
    "check:audit": "node scripts/check-dependency-audit.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:touch": "node scripts/check-touch-targets.mjs",
    "check:edge": "node scripts/check-edge-contracts.mjs",
    "check:edge:type": "deno check --node-modules-dir=manual supabase/functions/make-server-d962235e/index.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check": "npm run check:signing && npm run check:secrets && npm run check:i18n && npm run typecheck && npm test",
    "verify:release": "npm run format:check && npm run lint && npm run check:signing && npm run check:secrets && npm run check:licenses && npm run check:audit && npm run check:i18n && npm run check:touch && npm run typecheck && npm run test:unit && npm run test:component && npm run test:contract && npm run test:rls:static && npm run check:edge && npm run check:edge:type && npm run check:migrations && npx expo install --check && npm run doctor",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/slider": "5.2.0",
    "@sentry/react-native": "~8.23.0",
    "@supabase/supabase-js": "2.112.3",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.12",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.11",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.11.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.0",
    "deno": "2.9.3",
    "hono": "4.13.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "nodemailer": "9.0.3",
    "supabase": "2.109.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
