{
  "name": "wmatch-mobile",
  "private": true,
  "version": "1.0.51",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.19.0"
  },
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "deno@2.9.3": true
  },
  "main": "index.ts",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-dev-client.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-dev-client.ps1",
    "dev:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-dev-client.ps1",
    "dev:lan": "expo start --dev-client --clear --host lan",
    "dev:expo": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-dev-client.ps1",
    "dev:localhost": "expo start --dev-client --clear --host localhost",
    "android": "expo run:android",
    "logs:android": "powershell -ExecutionPolicy Bypass -File .\\watch-android-logs.ps1",
    "android:expo-go": "expo start --android",
    "ios": "expo run:ios",
    "ios:expo-go": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/check-source-quality.mjs",
    "test": "npm run test:vitest && npm run test:component",
    "test:vitest": "vitest run",
    "test:unit": "vitest run tests/shared-utils.test.ts tests/network-retry.test.ts tests/api-auth-refresh.test.ts tests/edge-http-security.test.ts tests/ota-classifier.test.ts tests/dependency-direction.test.ts tests/database-validation-workflow.test.ts",
    "test:component": "jest --config jest.config.js --runInBand",
    "test:contract": "vitest run tests/production-guards.test.ts",
    "test:edge:hmac": "deno test --allow-env --node-modules-dir=manual supabase/functions/make-server-d962235e/originHmac_test.ts",
    "test:edge:storage": "deno test --allow-env --node-modules-dir=manual supabase/functions/make-server-d962235e/domains/storage_test.ts",
    "test:edge:privacy": "deno test --allow-env --node-modules-dir=manual supabase/functions/make-server-d962235e/domains/privacy_test.ts supabase/functions/make-server-d962235e/domains/pushTokens_test.ts supabase/functions/make-server-d962235e/domains/pushDeliveryPolicy_test.ts supabase/functions/make-server-d962235e/domains/notificationOutbox_test.ts",
    "test:edge:account-deletion": "deno test --allow-env --node-modules-dir=manual supabase/functions/make-server-d962235e/accountDeletion_test.ts",
    "test:rls": "supabase test db supabase/tests/database",
    "test:rls:static": "node scripts/check-migrations.mjs",
    "test:db:nonce": "node scripts/database/local-db-validation.mjs nonce-concurrency",
    "test:db:restore": "node scripts/database/local-db-validation.mjs dump-restore",
    "check:signing": "node scripts/check-signing-identity.mjs",
    "check:native-parity": "node scripts/check-native-config-parity.mjs",
    "check:secrets": "node scripts/check-no-private-secrets.mjs",
    "check:licenses": "node scripts/check-dependency-licenses.mjs",
    "check:audit": "node scripts/check-dependency-audit.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:touch": "node scripts/check-touch-targets.mjs",
    "check:contrast": "node scripts/guards/check-contrast.mjs",
    "check:style-literals": "node scripts/guards/check-style-literals.mjs",
    "check:architecture": "node scripts/guards/check-dependency-direction.mjs",
    "check:visual-regression": "node scripts/guards/check-visual-regression.mjs",
    "check:db:advisors": "node scripts/database/local-db-validation.mjs advisors",
    "check:db:exposure": "node scripts/database/local-db-validation.mjs exposure",
    "check:edge": "node scripts/check-edge-contracts.mjs",
    "check:edge:type": "deno check --node-modules-dir=manual supabase/functions/make-server-d962235e/index.ts",
    "check:deno:lock": "deno cache --frozen --node-modules-dir=manual supabase/functions/make-server-d962235e/originHmac_test.ts supabase/functions/make-server-d962235e/domains/storage_test.ts supabase/functions/make-server-d962235e/domains/privacy_test.ts supabase/functions/make-server-d962235e/domains/pushTokens_test.ts supabase/functions/make-server-d962235e/domains/pushDeliveryPolicy_test.ts supabase/functions/make-server-d962235e/domains/notificationOutbox_test.ts supabase/functions/make-server-d962235e/accountDeletion_test.ts supabase/functions/make-server-d962235e/index.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:feature-surface": "node scripts/guards/check-no-new-product-surface.mjs",
    "docker:config": "node infra/docker/scripts/compose-control.mjs config",
    "docker:up:test": "node infra/docker/scripts/compose-control.mjs up-test",
    "docker:test": "node infra/docker/scripts/run-test-profile.mjs",
    "docker:resilience": "node infra/docker/scripts/run-resilience-profile.mjs",
    "docker:load": "node infra/docker/scripts/run-load-profile.mjs",
    "docker:down": "node infra/docker/scripts/compose-control.mjs down",
    "docker:clean": "node infra/docker/scripts/cleanup.mjs",
    "check": "npm run check:signing && npm run check:native-parity && npm run check:secrets && npm run check:i18n && npm run check:contrast && npm run check:style-literals && npm run check:architecture && npm run check:visual-regression && npm run check:feature-surface && npm run typecheck && npm test",
    "verify:release": "npm run format:check && npm run lint && npm run check:signing && npm run check:native-parity && npm run check:secrets && npm run check:licenses && npm run check:audit && npm run check:i18n && npm run check:touch && npm run check:contrast && npm run check:style-literals && npm run check:architecture && npm run check:visual-regression && npm run check:feature-surface && npm run typecheck && npm run test:unit && npm run test:component && npm run test:contract && npm run test:edge:hmac && npm run test:edge:storage && npm run test:edge:privacy && npm run test:edge:account-deletion && npm run test:rls:static && npm run check:edge && npm run check:deno:lock && npm run check:edge:type && npm run check:migrations && npx expo install --check && npm run doctor",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "2.107.0",
    "expo": "~57.0.20",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.17",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.0",
    "deno": "2.9.3",
    "hono": "4.13.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "nodemailer": "9.0.3",
    "supabase": "2.109.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
