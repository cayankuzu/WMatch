# Public client config that may remain in GitHub.
EXPO_PUBLIC_SUPABASE_PROJECT_ID=eaggwbuvpfzrejamwqry
EXPO_PUBLIC_SUPABASE_ANON_KEY=<PUBLIC_SUPABASE_ANON_KEY>
# Stable Cloudflare gateway host. Leave blank only during the measured direct-origin cutover.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_RELEASE_SHA=<IMMUTABLE_GIT_SHA>
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

SUPABASE_URL=https://eaggwbuvpfzrejamwqry.supabase.co
SUPABASE_PROJECT_REF=eaggwbuvpfzrejamwqry
SUPABASE_ANON_KEY=<PUBLIC_SUPABASE_ANON_KEY>
SUPABASE_PUBLISHABLE_KEY=<PUBLIC_SUPABASE_PUBLISHABLE_KEY>
TMDB_API_KEY=<TMDB_API_KEY>

# Restore these values only from the Desktop or USB `WMatch_secrests` backup bundle.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
ACCOUNT_DELETION_WORKER_SECRET=
# Cloudflare-to-Supabase origin signing. Keep REQUIRE false until the measured
# gateway cutover confirms old mobile binaries no longer need direct origin.
REQUIRE_CLOUDFLARE_ORIGIN_HMAC=false
ORIGIN_HMAC_KEY_ID=
ORIGIN_HMAC_SECRET=
ORIGIN_HMAC_PREVIOUS_KEY_ID=
ORIGIN_HMAC_PREVIOUS_SECRET=
ORIGIN_HMAC_MAX_SKEW_SECONDS=60
