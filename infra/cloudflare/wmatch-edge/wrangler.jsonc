{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wmatch-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "send_metrics": false,
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "REQUIRED__COMMA_SEPARATED_EXACT_ORIGINS",
    "ALLOWED_REDIRECT_ORIGINS": "REQUIRED__COMMA_SEPARATED_EXACT_REDIRECT_ORIGINS",
    "CACHE_VERSION": "v1",
    "ENVIRONMENT": "development",
    "JWT_AUDIENCE": "authenticated",
    "JWT_ISSUER": "REQUIRED__DEVELOPMENT_SUPABASE_AUTH_ISSUER",
    "JWT_JWKS_URL": "REQUIRED__DEVELOPMENT_SUPABASE_JWKS_URL",
    "ORIGIN_BASE_URL": "REQUIRED__DEVELOPMENT_SUPABASE_FUNCTION_URL",
    "ORIGIN_HMAC_KEY_ID": "development-v1",
    "ORIGIN_HMAC_MAX_SKEW_SECONDS": "60",
    "ORIGIN_MAX_RESPONSE_BYTES": "2097152",
    "ORIGIN_TIMEOUT_MS": "8000"
  },
  "secrets": {
    "required": [
      "ORIGIN_ANON_JWT",
      "ORIGIN_API_KEY",
      "ORIGIN_HMAC_SECRET",
      "RATE_LIMIT_HASH_SECRET"
    ]
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "10003",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "env": {
    "development": {
      "name": "wmatch-edge-development",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ALLOWED_ORIGINS": "REQUIRED__COMMA_SEPARATED_EXACT_ORIGINS",
        "ALLOWED_REDIRECT_ORIGINS": "REQUIRED__COMMA_SEPARATED_EXACT_REDIRECT_ORIGINS",
        "CACHE_VERSION": "v1",
        "ENVIRONMENT": "development",
        "JWT_AUDIENCE": "authenticated",
        "JWT_ISSUER": "REQUIRED__DEVELOPMENT_SUPABASE_AUTH_ISSUER",
        "JWT_JWKS_URL": "REQUIRED__DEVELOPMENT_SUPABASE_JWKS_URL",
        "ORIGIN_BASE_URL": "REQUIRED__DEVELOPMENT_SUPABASE_FUNCTION_URL",
        "ORIGIN_HMAC_KEY_ID": "development-v1",
        "ORIGIN_HMAC_MAX_SKEW_SECONDS": "60",
        "ORIGIN_MAX_RESPONSE_BYTES": "2097152",
        "ORIGIN_TIMEOUT_MS": "8000"
      },
      "secrets": {
        "required": [
          "ORIGIN_ANON_JWT",
          "ORIGIN_API_KEY",
          "ORIGIN_HMAC_SECRET",
          "RATE_LIMIT_HASH_SECRET"
        ]
      },
      "version_metadata": { "binding": "WORKER_VERSION" },
      "ratelimits": [
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "10001",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "10002",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "MUTATION_RATE_LIMITER",
          "namespace_id": "10003",
          "simple": { "limit": 20, "period": 60 }
        }
      ]
    },
    "preview": {
      "name": "wmatch-edge-preview",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ALLOWED_ORIGINS": "REQUIRED__COMMA_SEPARATED_EXACT_ORIGINS",
        "ALLOWED_REDIRECT_ORIGINS": "REQUIRED__COMMA_SEPARATED_EXACT_REDIRECT_ORIGINS",
        "CACHE_VERSION": "v1",
        "ENVIRONMENT": "preview",
        "JWT_AUDIENCE": "authenticated",
        "JWT_ISSUER": "REQUIRED__PREVIEW_SUPABASE_AUTH_ISSUER",
        "JWT_JWKS_URL": "REQUIRED__PREVIEW_SUPABASE_JWKS_URL",
        "ORIGIN_BASE_URL": "REQUIRED__PREVIEW_SUPABASE_FUNCTION_URL",
        "ORIGIN_HMAC_KEY_ID": "preview-v1",
        "ORIGIN_HMAC_MAX_SKEW_SECONDS": "60",
        "ORIGIN_MAX_RESPONSE_BYTES": "2097152",
        "ORIGIN_TIMEOUT_MS": "8000"
      },
      "secrets": {
        "required": [
          "ORIGIN_ANON_JWT",
          "ORIGIN_API_KEY",
          "ORIGIN_HMAC_SECRET",
          "RATE_LIMIT_HASH_SECRET"
        ]
      },
      "version_metadata": { "binding": "WORKER_VERSION" },
      "ratelimits": [
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "11001",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "11002",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "MUTATION_RATE_LIMITER",
          "namespace_id": "11003",
          "simple": { "limit": 20, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "wmatch-edge-production",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.05,
          "persist": true
        }
      },
      "vars": {
        "ALLOWED_ORIGINS": "REQUIRED__COMMA_SEPARATED_EXACT_ORIGINS",
        "ALLOWED_REDIRECT_ORIGINS": "REQUIRED__COMMA_SEPARATED_EXACT_REDIRECT_ORIGINS",
        "CACHE_VERSION": "v1",
        "ENVIRONMENT": "production",
        "JWT_AUDIENCE": "authenticated",
        "JWT_ISSUER": "REQUIRED__PRODUCTION_SUPABASE_AUTH_ISSUER",
        "JWT_JWKS_URL": "REQUIRED__PRODUCTION_SUPABASE_JWKS_URL",
        "ORIGIN_BASE_URL": "REQUIRED__PRODUCTION_SUPABASE_FUNCTION_URL",
        "ORIGIN_HMAC_KEY_ID": "production-v1",
        "ORIGIN_HMAC_MAX_SKEW_SECONDS": "60",
        "ORIGIN_MAX_RESPONSE_BYTES": "2097152",
        "ORIGIN_TIMEOUT_MS": "8000"
      },
      "secrets": {
        "required": [
          "ORIGIN_ANON_JWT",
          "ORIGIN_API_KEY",
          "ORIGIN_HMAC_SECRET",
          "RATE_LIMIT_HASH_SECRET"
        ]
      },
      "version_metadata": { "binding": "WORKER_VERSION" },
      "ratelimits": [
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "12001",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "12002",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "MUTATION_RATE_LIMITER",
          "namespace_id": "12003",
          "simple": { "limit": 20, "period": 60 }
        }
      ]
    }
  }
}
